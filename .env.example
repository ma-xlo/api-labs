# Infra compartilhada. Copie este arquivo para .env antes do primeiro `pnpm dev`.
# As portas são deslocadas de propósito para não colidir com o api-study.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5442
REDIS_PORT=6389

# Usados pelos scripts e pelos labs para montar os URLs de conexão.
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5442/postgres
REDIS_URL=redis://localhost:6389
